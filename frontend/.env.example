# Copy to frontend/.env for local development. Never commit the real .env.

# Django server the Vite dev server forwards /api requests to.
VITE_DEV_API_PROXY=http://127.0.0.1:8000

# Base URL of the backend, no trailing slash. Set it in Vercel's project
# settings, e.g. https://stormpath.onrender.com. Leave empty locally (the dev
# proxy forwards /api) or when Django serves the built frontend.
VITE_API_BASE=

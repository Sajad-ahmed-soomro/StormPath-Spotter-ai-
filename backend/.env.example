# Copy to backend/.env and adjust. Never commit the real .env.

# --- Django ---------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Frontends on another origin that may call the API: the Vite dev server
# locally, and the Vercel URL in production (e.g. https://stormpath.vercel.app).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex list for Vercel preview deploys, e.g. ^https://stormpath-.*\.vercel\.app$
CORS_ALLOWED_ORIGIN_REGEXES=

# --- Routing (OSRM). Comma-separated; later servers are hedges/fallbacks. ---
OSRM_URLS=https://router.project-osrm.org,https://routing.openstreetmap.de/routed-car

# --- Weather (Open-Meteo) --------------------------------------------------
# Sent to the browser, which downloads forecasts with the visitor's own quota.
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# --- Geocoding (Photon) ------------------------------------------------------
PHOTON_URL=https://photon.komoot.io

# --- Map tiles (served to the frontend via /api/meta/) -----------------------
BASEMAP_URL=https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}
BASEMAP_LABELS_URL=https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Reference/MapServer/tile/{z}/{y}/{x}

# Identifies this app to the public APIs above (their usage policies require it).
HTTP_USER_AGENT=StormPath/1.0 (weather-aware truck routing)

# --- Tuning ----------------------------------------------------------------
TRUCK_MAX_SPEED_MPH=65
